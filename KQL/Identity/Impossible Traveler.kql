// =====================================================
// Detection: Impossible Traveler
// Platform:  Microsoft Defender XDR / Advanced Hunting
// Table:     AADSignInEventsBeta
// Purpose:   Detects successful sign-ins from two geographically
//            distant locations within a short time window,
//            indicating the travel speed is physically impossible.
// =====================================================

let TimeWindow = 60m;
let DistanceThresholdKm = 500;
AADSignInEventsBeta
| where Timestamp > ago(TimeWindow)
| where isnotempty(AccountUpn)
| where isnotempty(IPAddress)
| where isnotempty(Latitude)
| where isnotempty(Longitude)
| where ErrorCode == 0
| where LogonType has_any ("interactiveUser")
| project
    Timestamp,
    AccountUpn,
    IPAddress,
    Country,
    City,
    Latitude,
    Longitude,
    UserAgent,
    SessionId,
    LogonType,
    EntraIdDeviceId,
    DeviceTrustType,
    IsManaged,
    IsCompliant
| order by AccountUpn asc, Timestamp asc
| serialize
| extend
    PrevTimestamp = prev(Timestamp),
    PrevAccount = prev(AccountUpn),
    PrevIP = prev(IPAddress),
    PrevCountry = prev(Country),
    PrevCity = prev(City),
    PrevLatitude = prev(Latitude),
    PrevLongitude = prev(Longitude),
    PrevEntraIdDeviceId = prev(EntraIdDeviceId),
    PrevDeviceTrustType = prev(DeviceTrustType),
    PrevIsManaged = prev(IsManaged),
    PrevIsCompliant = prev(IsCompliant)
| where AccountUpn == PrevAccount
| extend
    TimeDiffMinutes = datetime_diff('minute', Timestamp, PrevTimestamp)
| where TimeDiffMinutes > 0
| extend
    DistanceKm = geo_distance_2points(
        todouble(Longitude),
        todouble(Latitude),
        todouble(PrevLongitude),
        todouble(PrevLatitude)
    ) / 1000.0
| extend
    TravelSpeedKmh = (DistanceKm / todouble(TimeDiffMinutes)) * 60
| where DistanceKm > DistanceThresholdKm
| where TravelSpeedKmh > 900
| where Country != PrevCountry
| extend
    CurrentEntraIdDeviceId = EntraIdDeviceId,
    CurrentDeviceTrustType = DeviceTrustType,
    CurrentIsManaged = IsManaged,
    CurrentIsCompliant = IsCompliant,
    PreviousEntraIdDeviceId = PrevEntraIdDeviceId,
    PreviousDeviceTrustType = PrevDeviceTrustType,
    PreviousIsManaged = PrevIsManaged,
    PreviousIsCompliant = PrevIsCompliant
| extend TriggerReason = case(
        isnull(CurrentEntraIdDeviceId) or isnull(PreviousEntraIdDeviceId), "DeviceIdMissing",
        CurrentEntraIdDeviceId != PreviousEntraIdDeviceId, "DeviceMismatch",
        "NotTriggered"
    )
| where TriggerReason != "NotTriggered"
| project
    Timestamp,
    AccountUpn,
    CurrentIP = IPAddress,
    CurrentCountry = Country,
    PreviousCountry = PrevCountry,
    PreviousCity = PrevCity,
    DistanceKm,
    TimeDiffMinutes,
    TravelSpeedKmh,
    UserAgent,
    SessionId,
    LogonType,
    CurrentEntraIdDeviceId,
    CurrentDeviceTrustType,
    CurrentIsManaged,
    CurrentIsCompliant,
    PreviousEntraIdDeviceId,
    PreviousDeviceTrustType,
    PreviousIsManaged,
    PreviousIsCompliant,
    TriggerReason
| distinct AccountUpn, Timestamp, SessionId, CurrentIP, CurrentCountry, PreviousCountry, PreviousCity,
           DistanceKm, TimeDiffMinutes, TravelSpeedKmh, UserAgent, LogonType,
           CurrentEntraIdDeviceId, CurrentDeviceTrustType, CurrentIsManaged, CurrentIsCompliant,
           PreviousEntraIdDeviceId, PreviousDeviceTrustType, PreviousIsManaged, PreviousIsCompliant,
           TriggerReason
| order by TravelSpeedKmh desc
